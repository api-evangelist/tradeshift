{
  "opencollection": "1.0.0",
  "info": {
    "name": "MCP HTTP Bridge & Management Tools API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Tools",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List All Tools",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/tools/list",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "List all tools across allowed domains."
        },
        {
          "info": {
            "name": "List Category Tools",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/:category/tools/list",
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "List Category Tools"
        },
        {
          "info": {
            "name": "Execute Category Tool",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/:category/tools/execute",
            "params": [
              {
                "name": "category",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Execute Category Tool"
        }
      ]
    }
  ],
  "bundled": true
}
          "name": "find assignments",
          "request": {
            "name": "find assignments",
            "description": {
              "content": "Get a paginated list of assignments filtered by the following query parameters. The search will be performed on assignments from the current branch and child branches.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "external",
                "assignments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "companyid",
                  "value": "<string>",
                  "description": "Company (tenant) UUID used to filter assignments."
                },
                {
                  "disabled": false,
                  "key": "assigneeids",
                  "value": "<string>",
                  "description": "List of  UUIDs of assignees, used to filter assignments."
                },
                {
                  "disabled": false,
                  "key": "with_tags",
                  "value": "<string>",
                  "description": "List of strings representing tags to be used to filter assignments."
                },
                {
                  "disabled": false,
                  "key": "without_tags",
                  "value": "<string>",
                  "description": "List of strings representing tags to be used to exclude assignments."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "List of statuses to be used to filter assignment (e.g. OPEN, CLOSED, WAITING_FOR_ASSIGNEES)"
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "String representing a type used to filter assignments."
                },
                {
                  "disabled": false,
                  "key": "type_category",
                  "value": "<string>",
                  "description": "String representing a type category(a collection of assignment types)"
                },
                {
                  "disabled": false,
                  "key": "created_from",
                  "value": "<string>",
                  "description": "Datetime used to get assignments created after this date."
                },
                {
                  "disabled": false,
                  "key": "created_to",
                  "value": "<string>",
                  "description": "Datetime used to get assignments created before this date."
                },
                {
                  "disabled": false,
                  "key": "modified_from",
                  "value": "<string>",
                  "description": "Datetime used to get assignments modified after this date."
                },
                {
                  "disabled": false,
                  "key": "modified_to",
                  "value": "<string>",
                  "description": "Datetime used to get assignments modified before this date."
                },
                {
                  "disabled": false,
                  "key": "subjectid",
                  "value": "<string>",
                  "description": "Represents a free form identifier ( usually a document UUID ) of the subject the assignment is referring to and can be used to search assignments by.\n"
                },
                {
                  "disabled": false,
                  "key": "externalid",
                  "value": "<string>",
                  "description": "Free form string representing a custom client identifier which can be used later to search assignments by. Assignments service makes no uniqueness validation on this identifier.\n"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Number representing the page to be return from the paginated result-set."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "20",
                  "description": "The number of assignments displayed per page."
                },
                {
                  "disabled": false,
                  "key": "sortby",
                  "value": "<string>",
                  "description": "The sorting field."
                },
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "<string>",
                  "description": "The sorting direction."
                }

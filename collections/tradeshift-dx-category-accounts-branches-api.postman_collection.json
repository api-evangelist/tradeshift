          "name": "create branch",
          "request": {
            "name": "create branch",
            "description": {
              "content": "Creates a company account as the child of the current account using the provided data in the body of the PUT call. The branch will automatically be activated and no activation email will be sent to any branch users attached to the create request. The identifier(s) must not already exist.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "external",
                "account",
                "branches",
                "new"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"User\": {\n    \"Id\": \"<string>\"\n  },\n  \"CompanyAccount\": {\n    \"Company\": \"<object>\"\n  },\n  \"ParentCompanyAccountId\": \"<string>\",\n  \"From\": \"<string>\",\n  \"SendActivationEmail\": \"<boolean>\",\n  \"Properties\": {\n    \"termsandconditions\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }

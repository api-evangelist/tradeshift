      "item": [
        {
          "id": "7efece9f-b852-41af-a8c7-b2786172a6b3",
          "name": "Validate document",
          "request": {
            "name": "Validate document",
            "description": {
              "content": "Validate a document by testing matching validators, optionally specifying a category to filter the validator groups that are applied. Only the validator groups for the provided document type are run.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "rest",
                "external",
                "document-validation",
                "validation",
                "validate-document"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "senderTenantId",
                  "value": "<uuid>",
                  "description": "(Required) UUID of the user company (tenant) that is sending the document. This can be different than the 'tenantId' header value, for example when checking on behalf of a branch. The sender tenant id is used to obtain the connection properties of the connection between the receiver and sender, or other sender related settings."
                },
                {
                  "disabled": false,
                  "key": "receiverTenantId",
                  "value": "<uuid>",
                  "description": "(Required) UUID of the company (tenant) that will receive the document. The receiver tenant is used to check the validators of the receiver when the receiver company has configured validation for other companies sending documents (for example 'sellers' sending invoices to a 'buyer'), to obtain the connection properties of the connection between the receiver and sender, to obtain the country compliance validator groups of the receiver if enabled, or other receiver related settings."
                },
                {
                  "disabled": false,
                  "key": "documentId",
                  "value": "<uuid>",
                  "description": "Optional document id to validate, if provided the document content body is ignored."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/xml"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
